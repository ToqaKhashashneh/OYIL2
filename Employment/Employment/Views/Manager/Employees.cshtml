@model IEnumerable<Employment.Models.Employee>

<h2>Employees</h2>
<table class="table">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Image</th>
    </tr>
    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.Name</td>
            <td>@emp.Email</td>
            <td><img src="~/uploads/@emp.Image" width="250" /></td>
        </tr>
    }
</table>
