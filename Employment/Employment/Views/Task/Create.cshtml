@model Employment.Models.AssignTask

<h2>Assign Task</h2>
<form asp-action="Create">
    <input type="hidden" name="managerId" value="@ViewBag.ManagerId" />
    @* <div asp-validation-summary="All" class="text-danger"></div>
        this will show all errors in one place 
        if you want to show error for each field you can use
        <span asp-validation-for="FieldName" class="text-danger"></span> after each input field
        if you are reading this smile you are awesome :D!
    *@
    
    <div class="form-group">
        <label asp-for="TaskName" class="control-label"></label>
        <input asp-for="TaskName" class="form-control" />
         <span asp-validation-for="TaskName" class="text-danger"></span> 
    </div>
    <div class="form-group">
        <label>Start Date</label>
        <input type="date" asp-for="StartDate" class="form-control" required />
		 <span asp-validation-for="StartDate" class="text-danger"></span> 
    </div>
    <div class="form-group">
        <label>End Date</label>
        <input type="date" asp-for="EndDate" class="form-control" required />
		 <span asp-validation-for="EndDate" class="text-danger"></span> 
    </div>
    <div class="form-group">
        <label>Assign to</label>
        <select asp-for="EmplyeeId" asp-items="ViewBag.Employees" class="form-control"></select>
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}