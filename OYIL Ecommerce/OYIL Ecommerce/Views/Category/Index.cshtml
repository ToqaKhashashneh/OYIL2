<div class="container">
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <img src="@item.ImageUrl" class="card-img-top" />
                    <div class="card-body">
                        <h5>@item.Name</h5>
                        <p>@item.Description</p>


                        <a asp-action="ProductsByCategory"
                           asp-route-id="@item.CategoryId" class="btn btn-primary btn-sm">View All Products</a>

                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-warning btn-sm me-2">   Edit </a>

                        <a asp-action="Delete" asp-route-CategoryId="@item.CategoryId" class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>
</div>